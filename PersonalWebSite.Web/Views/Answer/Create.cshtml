@model PersonalWebSite.Web.Models.CreateAnswerViewModel

@{
    ViewData["Title"] = "Cevap Yaz";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card p-4">
            <h1 class="h3 mb-3">Cevap Yaz</h1>

            <div class="p-3 mb-4 rounded" style="background:#f4f7fb;">
                <h2 class="h6">@Model.QuestionTitle</h2>
                <p class="mb-0 text-muted" style="white-space:pre-line">@Model.QuestionContent</p>
            </div>

            <form asp-action="Create" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="QuestionId" />

                <div class="mb-4">
                    <label asp-for="Content" class="form-label"></label>
                    <textarea asp-for="Content" class="form-control" rows="6"></textarea>
                    <span asp-validation-for="Content" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-controller="Question" asp-action="Details" asp-route-id="@Model.QuestionId" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left"></i> Geri Dön
                    </a>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-paper-plane"></i> Cevabı Gönder</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
