@model PersonalWebSite.Web.Models.AnswerViewModel

@{
    ViewData["Title"] = "Cevabı Düzenle";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card p-4">
            <h1 class="h3 mb-4">Cevabı Düzenle</h1>

            <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="QuestionId" />

                <div class="mb-4">
                    <label asp-for="Content" class="form-label"></label>
                    <textarea asp-for="Content" class="form-control" rows="6"></textarea>
                    <span asp-validation-for="Content" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-controller="Question" asp-action="Details" asp-route-id="@Model.QuestionId" class="btn btn-outline-secondary">Vazgeç</a>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
