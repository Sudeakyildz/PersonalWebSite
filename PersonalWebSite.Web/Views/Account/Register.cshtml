@model PersonalWebSite.Web.Models.RegisterViewModel

@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="card auth-card">
    <h1>Hesap oluştur</h1>
    <p class="subtitle">Soru sormak için kayıt ol.</p>

    <form method="post" asp-action="Register" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

        <div class="row g-2">
            <div class="col-sm-6">
                <div class="form-floating mb-3">
                    <input asp-for="FirstName" class="form-control" autocomplete="given-name" placeholder="Ad" />
                    <label asp-for="FirstName"></label>
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-floating mb-3">
                    <input asp-for="LastName" class="form-control" autocomplete="family-name" placeholder="Soyad" />
                    <label asp-for="LastName"></label>
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="form-floating mb-3">
            <input asp-for="Email" class="form-control" autocomplete="username" placeholder="ornek@email.com" />
            <label asp-for="Email"></label>
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="form-floating mb-1">
            <input asp-for="Password" class="form-control" autocomplete="new-password" placeholder="Şifre" />
            <label asp-for="Password"></label>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="form-text mb-3">En az 8 karakter; büyük harf, küçük harf, rakam ve sembol içermeli.</div>
        <div class="form-floating mb-4">
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Şifre tekrarı" />
            <label asp-for="ConfirmPassword"></label>
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="w-100 btn btn-primary btn-lg">Kayıt Ol</button>
    </form>

    <p class="mt-4 mb-0 text-center">
        Zaten hesabın var mı? <a asp-action="Login">Giriş yap</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
