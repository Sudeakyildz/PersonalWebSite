@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="error-page">
    <div class="error-code">@Model.StatusCode</div>
    <h1 class="h3 mt-3">@Model.Title</h1>
    <p class="text-muted">@Model.Message</p>

    <div class="d-flex gap-2 justify-content-center mt-3">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Ana Sayfa</a>
        <a asp-controller="Question" asp-action="Index" class="btn btn-outline-primary">Sorulara Git</a>
    </div>

    @if (Model.ShowRequestId)
    {
        <p class="meta mt-4">İstek kimliği: <code>@Model.RequestId</code></p>
    }
</div>
