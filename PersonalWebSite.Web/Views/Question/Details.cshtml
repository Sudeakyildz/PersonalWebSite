@model PersonalWebSite.Web.Models.QuestionViewModel

@{
    ViewData["Title"] = Model.Title;
    var isAdmin = User.IsInRole("Admin");
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <a asp-action="Index" class="d-inline-block mb-3"><i class="fas fa-arrow-left"></i> Tüm sorular</a>

        <article class="card question-detail mb-4">
            <h1>@Model.Title</h1>
            <p class="meta mb-3">
                <i class="fas fa-user"></i>@Model.AuthorName ·
                <i class="far fa-clock"></i>@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                @if (Model.UpdatedAt.HasValue)
                {
                    <span>· düzenlendi</span>
                }
            </p>
            <div class="question-body">@Model.Content</div>

            @if (Model.CanManage)
            {
                <hr />
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">
                        <i class="fas fa-pen"></i> Düzenle
                    </a>
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-confirm="Bu soruyu silmek istediğinizden emin misiniz?">
                        <button type="submit" class="btn btn-outline-danger btn-sm"><i class="fas fa-trash"></i> Sil</button>
                    </form>
                </div>
            }
        </article>

        <h2 class="h5 mb-3"><i class="fas fa-comments"></i> Cevaplar (@Model.Answers.Count)</h2>

        @if (Model.Answers.Any())
        {
            foreach (var answer in Model.Answers)
            {
                <div class="card answer-card mb-3">
                    <div class="answer-body">@answer.Content</div>
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <span class="meta">
                            <i class="fas fa-shield-alt text-primary"></i>@answer.AuthorName ·
                            @answer.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            @if (answer.UpdatedAt.HasValue)
                            {
                                <span>· düzenlendi</span>
                            }
                        </span>
                        @if (isAdmin)
                        {
                            <div class="d-flex gap-2">
                                <a asp-controller="Answer" asp-action="Edit" asp-route-id="@answer.Id" class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-pen"></i> Düzenle
                                </a>
                                <form asp-controller="Answer" asp-action="Delete" asp-route-id="@answer.Id" method="post" data-confirm="Bu cevabı silmek istediğinizden emin misiniz?">
                                    <button type="submit" class="btn btn-outline-danger btn-sm"><i class="fas fa-trash"></i> Sil</button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-secondary"><i class="fas fa-info-circle"></i> Bu soruya henüz cevap verilmemiş.</div>
        }

        @if (isAdmin)
        {
            <div class="card p-4 mt-4">
                <h3 class="h6 mb-3"><i class="fas fa-shield-alt text-primary"></i> Cevap yaz</h3>
                <form asp-controller="Answer" asp-action="Create" method="post">
                    <input type="hidden" name="QuestionId" value="@Model.Id" />
                    <div class="mb-3">
                        <textarea name="Content" class="form-control" rows="4" required placeholder="Cevabınızı yazın..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-paper-plane"></i> Cevabı Gönder</button>
                </form>
            </div>
        }
        else if (User.Identity?.IsAuthenticated == true)
        {
            <div class="alert alert-info mt-3"><i class="fas fa-info-circle"></i> Sorulara yalnızca site sahibi cevap verebilir.</div>
        }
    </div>
</div>
