@model PersonalWebSite.Web.Models.QuestionViewModel

@{
    ViewData["Title"] = "Yeni Soru";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card p-4">
            <h1 class="h3 mb-1">Yeni Soru</h1>
            <p class="text-muted">Merak ettiğin konuyu net bir şekilde yaz.</p>

            <form asp-action="Create" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" maxlength="200" placeholder="Örn. ASP.NET Core'da dependency injection nasıl çalışır?" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Content" class="form-label"></label>
                    <textarea asp-for="Content" class="form-control" rows="7" placeholder="Detayları yaz..."></textarea>
                    <span asp-validation-for="Content" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-paper-plane"></i> Soruyu Yayınla</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
