                "GitHub OAuth ve e-posta OTP/2FA doğrulama akışlarını otomatikleştirdim."
            },
            new[] { "Python", "Pytest", "SeleniumBase", "C#", "ASP.NET Core", "React", "Node.js", "SQL Server", "Git" }),
