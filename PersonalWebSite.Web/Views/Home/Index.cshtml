<div class="main-wrapper">
    <!-- Hero -->
    <section class="hero-section">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <div class="hero-content">
                        <span class="open-badge"><span class="dot"></span> Yeni fırsatlara açığım</span>
                        <p class="hero-hello">Merhaba, ben</p>
                        <h1 class="glitch">Sude Nur Akyıldız</h1>
                        <div class="typing-text">
                            <span class="typed"></span>
                        </div>
                        <p class="hero-description">
                            Bilgisayar Mühendisliği mezunu. Yazılım geliştirme, yapay zeka, makine öğrenmesi ve bilgisayarlı görü alanlarında güçlü bir ilgiye sahibim. Gerçek dünya problemlerine akıllı çözümler üretmeyi, yeni teknolojiler öğrenmeyi ve yenilikçi projelere katkı sağlamayı hedefliyorum.
                        </p>
                        <p class="hero-location"><i class="fas fa-map-marker-alt"></i> İstanbul, Türkiye</p>
                        <div class="hero-buttons">
                            <a href="#projects" class="btn btn-primary"><i class="fas fa-folder-open"></i> Projelerimi Gör</a>
                            <a href="https://sudeakyildz.github.io/pdf.html" class="btn btn-outline-primary" target="_blank" rel="noopener"><i class="fas fa-file-alt"></i> CV Görüntüle</a>
                            <a href="https://github.com/Sudeakyildz" class="btn btn-github" target="_blank" rel="noopener"><i class="fab fa-github"></i> GitHub</a>
                            <a href="https://www.linkedin.com/in/sude-a-9592b3343/" class="btn btn-linkedin" target="_blank" rel="noopener"><i class="fab fa-linkedin"></i> LinkedIn</a>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="hero-image">
                        <img src="~/images/ben.png" alt="Sude Nur Akyıldız" class="profile-image">
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- About -->
    <section id="about" class="experience-section">
        <div class="container">
            <h2 class="section-title">Hakkımda</h2>
            <div class="row g-4 align-items-stretch">
                <div class="col-lg-7">
                    <div class="info-card h-100">
                        <h3>Gerçek problemlere akıllı çözümler</h3>
                        <p>
                            Bilgisayar Mühendisliği mezunuyum. Yazılım geliştirme, yapay zeka, makine öğrenmesi ve bilgisayarlı görü alanlarında güçlü bir ilgiye sahibim.
                            Full-stack web uygulamalarından gerçek zamanlı görüntü işleme sistemlerine kadar uçtan uca projeler geliştirdim.
                        </p>
                        <div class="edu">
                            <i class="fas fa-graduation-cap"></i>
                            <div>
                                <strong>Bilecik Şeyh Edebali Üniversitesi</strong><br />
                                Bilgisayar Mühendisliği Lisans · 2022 – 2026
                            </div>
                        </div>
                        <div class="langs">
                            <span class="chip"><i class="fas fa-language"></i> İngilizce · B1–B2</span>
                            <span class="chip"><i class="fas fa-language"></i> Almanca · Temel</span>
                        </div>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="stats-grid h-100">
                        <div class="stat"><strong>3</strong><span>Staj Deneyimi</span></div>
                        <div class="stat"><strong>6</strong><span>Proje</span></div>
                        <div class="stat"><strong>30+</strong><span>Teknoloji</span></div>
                        <div class="stat"><strong>%100</strong><span>Tehdit Recall (AI Projesi)</span></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Skills -->
    <section id="skills" class="skills-section">
        <div class="container">
            <h2 class="section-title">Yetenekler</h2>
            <p class="section-lead">Yazılım geliştirmeden yapay zekaya, full-stack uygulamalardan bilgisayarlı görüye geniş bir teknoloji yelpazesi.</p>
            <div class="skills-grid">
                @foreach (var group in skillGroups)
                {
                    <div class="skill-card">
                        <div class="skill-icon"><i class="fas @group.Icon"></i></div>
                        <h3>@group.Title</h3>
                        <div class="chips">
                            @foreach (var item in group.Items)
                            {
                                <span class="chip">@item</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- Experience -->
    <section id="experience" class="experience-section">
        <div class="container">
            <h2 class="section-title">Deneyim</h2>
            <div class="timeline">
                @foreach (var exp in experiences)
                {
                    <div class="timeline-item">
                        <div class="timeline-content">
                            <h3>@exp.Role</h3>
                            <p class="exp-meta"><strong>@exp.Company</strong> · @exp.Period</p>
                            <ul class="exp-points">
                                @foreach (var point in exp.Points)
                                {
                                    <li>@point</li>
                                }
                            </ul>
                            <div class="chips">
                                @foreach (var t in exp.Tech)
                                {
                                    <span class="chip">@t</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- Projects -->
    <section id="projects" class="skills-section">
        <div class="container">
            <h2 class="section-title">Seçili Projeler</h2>
            <p class="section-lead">Yapay zeka, bilgisayarlı görü ve full-stack web geliştirme alanlarından işler.</p>
            <div class="projects-grid">
                @foreach (var p in projects)
                {
                    <article class="project-card">
                        <span class="pill">@p.Category</span>
                        <h3>@p.Title</h3>
                        <p>@p.Description</p>
                        <ul class="exp-points">
                            @foreach (var point in p.Points)
                            {
                                <li>@point</li>
                            }
                        </ul>
                        <div class="chips">
                            @foreach (var t in p.Tech)
                            {
                                <span class="chip">@t</span>
                            }
                        </div>
                    </article>
                }
            </div>
            <p class="text-center mt-4">
                <a href="https://github.com/Sudeakyildz" target="_blank" rel="noopener" class="btn btn-outline-primary">
                    <i class="fab fa-github"></i> Tüm projeler GitHub'da
                </a>
            </p>
        </div>
    </section>

    <!-- Q&A -->
    <section class="qa-section">
        <div class="container">
            <div class="qa-card">
                <div class="qa-content">
                    <h2>Soru &amp; Cevap</h2>
                    <p>Yazılım geliştirme, yapay zeka ve web teknolojileri hakkında merak ettiklerinizi sorabilirsiniz.</p>
                    <a asp-controller="Question" asp-action="Index" class="btn btn-primary btn-lg">
                        <i class="fas fa-list"></i> Soruları Görüntüle
                    </a>
                    <a asp-controller="Question" asp-action="Create" class="btn btn-outline-primary btn-lg ms-2">
                        <i class="fas fa-pen"></i> Soru Sor
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="experience-section">
        <div class="container text-center">
            <h2 class="section-title">İletişim</h2>
            <p class="section-lead">Yeni projeler, iş fırsatları veya iş birliği için bana ulaşabilirsiniz.</p>
            <a href="mailto:Sudeaky5@gmail.com" class="btn btn-primary btn-lg"><i class="fas fa-envelope"></i> Sudeaky5@gmail.com</a>
            <div class="mt-3 contact-links">
                <a href="https://github.com/Sudeakyildz" target="_blank" rel="noopener"><i class="fab fa-github"></i> GitHub</a>
                <a href="https://www.linkedin.com/in/sude-a-9592b3343/" target="_blank" rel="noopener"><i class="fab fa-linkedin"></i> LinkedIn</a>
                <a href="https://sudeakyildz.github.io/" target="_blank" rel="noopener"><i class="fas fa-globe"></i> Portfolyo</a>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/typed.js@2.0.12"></script>
    <script>
        new Typed('.typed', {
            strings: ['Bilgisayar Mühendisliği Mezunu', 'Yazılım Geliştirici', 'Yapay Zeka & Bilgisayarlı Görü'],
            typeSpeed: 50,
            backSpeed: 30,
            backDelay: 1500,
            loop: true
        });
    </script>
}
